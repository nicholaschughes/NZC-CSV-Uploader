<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Color Button</masterLabel>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__Tab</target>
        <target>lightning__UtilityBar</target>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage,lightning__UtilityBar">
            <property name="label" type="String" label="Heading label" description="Optional heading text above the button."/>
            <property name="buttonText" type="String" label="Button text" description="Text shown inside the button."/>
            <property name="colors" type="String" label="Color list" description="Comma-separated list of CSS colors (e.g. #1b96ff, #2e8540, red)."/>
        </targetConfig>
        <!-- Remove lightning__Tab targetConfig to avoid 'no design info' error -->
        <targetConfig targets="lightning__FlowScreen">
            <property name="label" type="String" label="Heading label"/>
            <property name="buttonText" type="String" label="Button text"/>
            <property name="colors" type="String" label="Color list"/>
            <!-- flowInput/flowOutput are not supported for LWC; remove them -->
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
